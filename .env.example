# Copy to .env — all service ports and base URLs in one place.
# Every *_SERVICE_URL is the address a consumer calls; point it at a mock
# (see the 45xx ports below) to run against a mock instead of the real service.

# Booking — the public API / gateway
BOOKING_PORT=3000
BOOKING_SERVICE_URL=http://localhost:3000

# Schedule
SCHEDULE_PORT=3001
SCHEDULE_SERVICE_URL=http://localhost:3001

# Payment
PAYMENT_PORT=3002
PAYMENT_SERVICE_URL=http://localhost:3002

# Notification
NOTIFICATION_PORT=3003
NOTIFICATION_SERVICE_URL=http://localhost:3003

# Weather
WEATHER_PORT=3004
WEATHER_SERVICE_URL=http://localhost:3004

# OpenWeather (3rd-party upstream the Weather service wraps).
# Point OPENWEATHER_API_URL at http://localhost:4504 to use the local mock,
# and add your own key from https://openweathermap.org/api for the real API.
OPENWEATHER_API_URL=https://api.openweathermap.org
OPENWEATHER_API_KEY=dev-placeholder-key

# Status dashboard (read-only health page — see http://localhost:3005)
STATUS_PORT=3005
